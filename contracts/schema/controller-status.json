{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ControllerStatus",
  "description": "Payload of stl/<iid>/controller/status, MQTT contract v1.",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "online": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "enum": [
        "sim",
        "live"
      ]
    },
    "bootCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "v",
    "online",
    "source"
  ]
}
