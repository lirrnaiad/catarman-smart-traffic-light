# Copy to .env (gitignored). Every value is optional; these are the defaults (AD-15).

# Local Mosquitto.
MQTT_URL=mqtt://127.0.0.1:1883

# The <iid> in every topic stl/<iid>/...
INTERSECTION_ID=int-01

# Optional. Only the M2 hotspot broker needs it; shared by the sim users
# (the username is the role's clientId, e.g. stl-sim-controller).
# MQTT_PASSWORD=
