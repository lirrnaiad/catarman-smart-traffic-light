{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ControllerState",
  "description": "Payload of stl/<iid>/controller/state, MQTT contract v1.",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "level": {
      "type": "string",
      "enum": [
        "L1",
        "L2",
        "L3",
        "L4"
      ]
    },
    "signals": {
      "type": "object",
      "properties": {
        "NS": {
          "type": "string",
          "enum": [
            "GREEN",
            "YELLOW",
            "RED",
            "FLASHING_AMBER",
            "DARK"
          ]
        },
        "EW": {
          "type": "string",
          "enum": [
            "GREEN",
            "YELLOW",
            "RED",
            "FLASHING_AMBER",
            "DARK"
          ]
        }
      },
      "required": [
        "NS",
        "EW"
      ]
    },
    "flood": {
      "type": "string",
      "enum": [
        "DRY",
        "WET",
        "FLOODED"
      ]
    },
    "fault": {
      "type": "boolean"
    },
    "override": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "NONE"
            },
            "commandId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "FLASHING_AMBER"
            },
            "commandId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "mode",
            "commandId"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "CORRIDOR"
            },
            "phase": {
              "type": "string",
              "enum": [
                "NS",
                "EW"
              ]
            },
            "commandId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "mode",
            "phase",
            "commandId"
          ]
        }
      ]
    },
    "remainingS": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "power": {
      "type": "string",
      "enum": [
        "USB",
        "BATTERY"
      ]
    }
  },
  "required": [
    "v",
    "level",
    "signals",
    "flood",
    "fault"
  ]
}
