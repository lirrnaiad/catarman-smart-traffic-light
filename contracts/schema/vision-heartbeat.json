{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VisionHeartbeat",
  "description": "Payload of stl/<iid>/vision/heartbeat, MQTT contract v1.",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "ts": {
      "type": "integer",
      "minimum": 1600000000000,
      "maximum": 4100000000000
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ok": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "fps": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "v",
    "ts",
    "seq",
    "ok",
    "confidence",
    "fps"
  ]
}
