# Copy to .env (gitignored). The one database variable; dbmate and src/config.ts both read it (AD-10).
DATABASE_URL=mysql://stl:stl@127.0.0.1:3306/stl

# Dev CORS allow-list, comma separated (AD-15). Optional; this is the default.
DASHBOARD_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local Mosquitto (AD-15). Optional; this is the default.
MQTT_URL=mqtt://127.0.0.1:1883

# The <iid> in every topic stl/<iid>/... Optional; this is the default.
INTERSECTION_ID=int-01

# Optional. Only the M2 hotspot broker needs it; the username is always stl-backend.
# MQTT_PASSWORD=
