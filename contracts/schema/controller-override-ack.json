{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ControllerOverrideAck",
  "description": "Payload of stl/<iid>/controller/override/ack, MQTT contract v1.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "commandId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "result": {
          "type": "string",
          "const": "APPLIED"
        }
      },
      "required": [
        "v",
        "commandId",
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "v": {
          "type": "number",
          "const": 1
        },
        "commandId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "result": {
          "type": "string",
          "const": "REJECTED"
        },
        "reason": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,31}$"
        }
      },
      "required": [
        "v",
        "commandId",
        "result",
        "reason"
      ]
    }
  ]
}
